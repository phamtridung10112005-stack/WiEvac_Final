<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alarm_bg"
    android:keepScreenOn="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.28"
            android:text="@string/alarm_kicker"
            android:textColor="@color/alarm"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/alarm_headline"
            android:textColor="@color/white"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/alarm_screen_body"
            android:textColor="@color/alarm_ink"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/stop"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_stop"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/stop_test"
        android:textColor="@color/alarm_bg"
        android:textSize="17sp"
        android:textStyle="bold" />
</LinearLayout>
